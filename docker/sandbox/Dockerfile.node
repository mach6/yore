# A yore fleet node: one machine in the 20-node sandbox (docker/sandbox/fleet.yml).
#
# The base image is a build arg, so the SAME Dockerfile produces a node on every
# distribution the fleet runs; alpine, debian, ubuntu, fedora, almalinux, arch,
# opensuse. The package step picks the distro's package manager at build time;
# the yore binary itself is CGO-free and static, so one build stage serves them
# all (and the build stage is shared cache across every node image).
#
# Both shells are installed and both rc files carry the yore hooks; a node's
# service sets YORE_SHELL to say which one it *is*, and the harness drives that
# shell. socat + jq are the harness's tools: the daemon speaks newline-delimited
# JSON over a unix socket, which is how a script approves a device or reads
# status without a TUI.
ARG BASE_IMAGE=alpine:3.20

FROM golang:1.26-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /yore ./cmd/yore

FROM ${BASE_IMAGE}
# hadolint ignore=DL3008,DL3018,DL3041
RUN set -eu; \
    if   command -v apk     >/dev/null 2>&1; then \
        apk add --no-cache bash zsh socat jq ca-certificates procps util-linux-misc; \
    elif command -v apt-get >/dev/null 2>&1; then \
        export DEBIAN_FRONTEND=noninteractive; \
        apt-get update; \
        apt-get install -y --no-install-recommends bash zsh socat jq ca-certificates procps; \
        rm -rf /var/lib/apt/lists/*; \
    elif command -v dnf     >/dev/null 2>&1; then \
        dnf -y install bash zsh socat jq ca-certificates procps-ng /usr/bin/script; dnf clean all; \
    elif command -v pacman  >/dev/null 2>&1; then \
        pacman -Sy --noconfirm --needed bash zsh socat jq ca-certificates procps-ng; \
        rm -rf /var/cache/pacman/pkg/*; \
    elif command -v zypper  >/dev/null 2>&1; then \
        zypper -n --gpg-auto-import-keys refresh; \
        zypper -n install bash zsh socat jq ca-certificates procps; zypper clean -a; \
    else echo "unsupported base image: no known package manager" >&2; exit 1; fi; \
    # Fail the BUILD, not the test run, if a distro's packaging left out a tool
    # the harness needs. `script` is the pty (driving a real interactive shell),
    # socat the daemon socket, jq the daemon's JSON.
    for t in bash zsh script socat jq timeout pgrep; do \
      command -v "$t" >/dev/null 2>&1 || { echo "missing tool: $t" >&2; exit 1; }; \
    done

COPY --from=build /yore /usr/local/bin/yore

# Cobra completions for both shells, then the yore integration in each rc (the
# mode comes from config.toml, so one line serves takeover/coexist/capture).
RUN mkdir -p /usr/share/bash-completion/completions /usr/local/share/zsh/site-functions \
 && yore completion bash > /usr/share/bash-completion/completions/yore \
 && yore completion zsh  > /usr/local/share/zsh/site-functions/_yore \
 && printf '%s\n' \
      'fpath=(/usr/local/share/zsh/site-functions $fpath)' \
      'autoload -Uz compinit && compinit -u' \
      'eval "$(yore init zsh)"' >> /root/.zshrc \
 && printf '%s\n' \
      '[ -f /usr/share/bash-completion/bash_completion ] && . /usr/share/bash-completion/bash_completion' \
      'eval "$(yore init bash)"' >> /root/.bashrc

COPY docker/sandbox/client-entrypoint.sh /usr/local/bin/client-entrypoint.sh
RUN chmod +x /usr/local/bin/client-entrypoint.sh
ENTRYPOINT ["/usr/local/bin/client-entrypoint.sh"]
CMD ["sleep", "infinity"]
