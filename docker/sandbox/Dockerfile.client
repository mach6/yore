# A yore client container with both zsh and bash installed and the yore hooks
# wired into each shell's rc. One image backs both the `zsh` and `bash` sandbox
# services; you pick the shell when you `exec` in.
FROM golang:1.26-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /yore ./cmd/yore

FROM alpine:3.20
# socat + jq are the harness's tools: approving a device is a keypress in the
# devices view, and the view is a client of the daemon's newline-delimited-JSON
# unix socket — which a script can speak too (see stress.sh).
RUN apk add --no-cache zsh bash bash-completion ca-certificates socat jq
COPY --from=build /yore /usr/local/bin/yore
# Install yore's cobra completions for both shells.
RUN mkdir -p /usr/share/bash-completion/completions /usr/local/share/zsh/site-functions \
 && yore completion bash > /usr/share/bash-completion/completions/yore \
 && yore completion zsh  > /usr/local/share/zsh/site-functions/_yore
# Enable each shell's completion framework, then source the yore integration
# (mode comes from config.json). zsh needs compinit; bash needs bash-completion.
RUN printf '%s\n' \
      'fpath=(/usr/local/share/zsh/site-functions $fpath)' \
      'autoload -Uz compinit && compinit' \
      'eval "$(yore init zsh)"' >> /root/.zshrc \
 && printf '%s\n' \
      '[ -f /usr/share/bash-completion/bash_completion ] && . /usr/share/bash-completion/bash_completion' \
      'eval "$(yore init bash)"' >> /root/.bashrc
COPY docker/sandbox/client-entrypoint.sh /usr/local/bin/client-entrypoint.sh
RUN chmod +x /usr/local/bin/client-entrypoint.sh
ENTRYPOINT ["/usr/local/bin/client-entrypoint.sh"]
CMD ["sleep", "infinity"]
